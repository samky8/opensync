# Production value: https://opensync.ca (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public GA4 ID. Omit to use the existing OpenSync stream, or set empty to disable.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-YEWELHFR22
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
SUPABASE_SECRET_KEY=
# 32 random bytes encoded as 64 hex characters
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
# Optional dedicated secret for email rate-limit keys. Defaults to the server database credential.
RATE_LIMIT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_BUSINESS_PROFILE_APPROVED=false
# Optional: enables live Google Maps comparison in the public hours checker.
GOOGLE_PLACES_API_KEY=
# Meta direct publishing: Facebook Login, Pages, and Instagram API with Facebook Login.
# Requires a public HTTPS NEXT_PUBLIC_APP_URL and migration 004.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
NEXT_PUBLIC_GOOGLE_SIGN_IN=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
BUSINESS_LOCATION_LIMIT=10
# Development only; ignored when NODE_ENV=production
DEV_PAID_FEATURES=false
SUPPORT_EMAIL=
PRIVACY_EMAIL=
# Transactional email provider used by notification delivery.
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=OpenSync <notifications@opensync.ca>
